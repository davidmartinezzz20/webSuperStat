# Apache, que es lo que sirve PiensaSolutions. Este archivo tiene que subir con
# el resto: sin él la web funciona, pero sin https forzado, sin caché y con la
# página de error del hosting en vez de la nuestra.
#
# Ojo al sustituir el WordPress: el .htaccess que había en public_html era el
# suyo y mandaba todas las peticiones a index.php. Hay que quitarlo, no
# añadirle esto debajo.

# ------------------------------------------------------------------ https
# El dominio lleva certificado; sin esto, quien escriba superstat.online a
# pelo se queda en http y el navegador lo marca como no seguro.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------------- error
ErrorDocument 404 /404.html

# ------------------------------------------------------------------- caché
# Las imágenes y los estilos llevan el nombre fijo, así que un año de caché
# sería quedarse con la versión vieja tras un despliegue. Una semana es el
# punto medio: rápido para quien vuelve, y corto para no pelearse con una
# actualización. El HTML no se cachea nunca.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType image/webp                "access plus 1 week"
  ExpiresByType image/png                 "access plus 1 week"
  ExpiresByType image/svg+xml             "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------- compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/xml image/svg+xml
</IfModule>

# --------------------------------------------------------------------- tipos
# Algunos Apache viejos no conocen WebP y lo sirven como descarga.
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ------------------------------------------------------------------ listados
# Sin esto, una carpeta sin index (img/, por ejemplo) enseña el listado de
# archivos.
Options -Indexes
